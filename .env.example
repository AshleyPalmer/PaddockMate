# ==============================================================================
# PaddockMate Environment Configuration Template
# Copy this file to '.env' to override default configuration:
#   cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=paddockmate
POSTGRES_USER=paddockmate
POSTGRES_PASSWORD=paddockmate
POSTGRES_PORT=5433

# Backend Spring Boot Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/paddockmate
SPRING_DATASOURCE_USERNAME=paddockmate
SPRING_DATASOURCE_PASSWORD=paddockmate

# Frontend Vite Configuration
VITE_API_PROXY_TARGET=http://backend:8080

# Social Authentication (Scheduled for Phase 3)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# FACEBOOK_CLIENT_ID=your-facebook-client-id
# FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
